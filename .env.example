# -------------------------------------------------------
# Application
# -------------------------------------------------------
PORT=3000
NODE_ENV=development

# -------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------
DATABASE_URL=postgresql://user:pass@localhost:5432/debate_timer

# -------------------------------------------------------
# Amplitude
# Amplitude Dashboard/Export API는 API Key + Secret Key 쌍이 필요하다.
# Amplitude 프로젝트 설정 > General에서 확인.
# -------------------------------------------------------
AMPLITUDE_API_KEY=your_amplitude_api_key
AMPLITUDE_SECRET_KEY=your_amplitude_secret_key

# -------------------------------------------------------
# Discord Webhooks
# 채널별로 Webhook URL을 분리한다.
#   TEST    : 로컬·개발 환경 전용 테스트 채널
#   REPORT  : 주간/월간 리포트 채널 (운영)
#   ALERT   : 지표 경고 채널 (운영)
#   OPS     : 시스템 운영 경고 채널 (실패 알림 등)
# Phase 1에서는 TEST만 필요하다.
# -------------------------------------------------------
DISCORD_WEBHOOK_URL_TEST=https://discord.com/api/webhooks/XXXXXXXXXX/XXXXXXXXXX
DISCORD_WEBHOOK_URL_REPORT=https://discord.com/api/webhooks/XXXXXXXXXX/XXXXXXXXXX
DISCORD_WEBHOOK_URL_ALERT=https://discord.com/api/webhooks/XXXXXXXXXX/XXXXXXXXXX
DISCORD_WEBHOOK_URL_OPS=https://discord.com/api/webhooks/XXXXXXXXXX/XXXXXXXXXX

# -------------------------------------------------------
# Schedule (cron 표현식, Asia/Seoul 기준)
# 기본값: 주간 매주 월요일 09:00 KST, 월간 매월 1일 09:00 KST
# -------------------------------------------------------
SCHEDULE_WEEKLY_REPORT="0 9 * * 1"
SCHEDULE_MONTHLY_REPORT="0 9 1 * *"

# -------------------------------------------------------
# Logging
# 허용값: fatal | error | warn | info | debug | trace
# -------------------------------------------------------
LOG_LEVEL=info

# -------------------------------------------------------
# AI (Phase 8에서 활성화)
# 1차 구현에서는 AI_ENABLED=false 상태로 템플릿 요약을 사용한다.
# -------------------------------------------------------
AI_ENABLED=false
# AI_PROVIDER=gemini
# AI_API_KEY=your_gemini_api_key
# AI_MODEL=gemini-2.0-flash
# AI_MAX_TOKENS_PER_CALL=4000
# AI_MAX_CALLS_PER_CYCLE=3

# -------------------------------------------------------
# Sentry (Phase 9에서 활성화)
# -------------------------------------------------------
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# SENTRY_ORG=your_org_slug
# SENTRY_PROJECT=your_project_slug
